# codepen
# Compact prompt structure for Oh My Zsh.
# Palette: https://github.com/ziqq/vscode_codepen_theme

PROMPT='%B%F{#FF5370}➜ %F{#FFFFFF} %c %F{#809BBD}$(git_prompt_info) %F{#809BBD}%% %f%b'

ZSH_THEME_GIT_PROMPT_PREFIX='%F{#809BBD}git:(%F{#FF5370}'
ZSH_THEME_GIT_PROMPT_SUFFIX='%f%b'
ZSH_THEME_GIT_PROMPT_DIRTY='%F{#809BBD}) %F{#FF5370}✗'
ZSH_THEME_GIT_PROMPT_CLEAN='%F{#809BBD})'
